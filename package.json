{
  "name": "telegram-claude-assistant",
  "version": "1.0.0",
  "description": "Личный ассистент в Telegram на базе Claude API",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "test": "node --test --test-force-exit \"src/**/test.js\"",
    "postinstall": "node scripts/generate-prisma-client.js",
    "db:generate": "node scripts/generate-prisma-client.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-sqlite3": "^12.6.0",
    "dotenv": "^16.4.5",
    "node-cron": "^4.6.0",
    "prisma": "7.10.0",
    "telegraf": "^4.16.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
